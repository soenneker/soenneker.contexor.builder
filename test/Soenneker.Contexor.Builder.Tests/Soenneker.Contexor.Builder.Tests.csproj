<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net11.0</TargetFramework>
        <Features Condition="'$(TargetFramework)' == 'net11.0'">$(Features);runtime-async=on</Features>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>
    </PropertyGroup>

    <ItemGroup>
        <None Remove="appsettings.json" />
    </ItemGroup>

    <ItemGroup>
        <Content Include="appsettings.json">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Content>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Soenneker.Utils.Process" Version="11.0.1603" />
        <PackageReference Include="Soenneker.Utils.Test" Version="11.0.344" />
        <PackageReference Include="Soenneker.Tests.Attributes.Local" Version="11.0.154" />
        <PackageReference Include="Soenneker.Tests.HostedUnit" Version="11.0.346" />
        <PackageReference Include="TUnit" Version="1.76.28" />
    </ItemGroup>

    <ItemGroup>
        <Content Include="Fixtures\codex_app_server_protocol.schemas.json" Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
        <Content Include="Fixtures\codex_app_server_protocol.v2.schemas.json" Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
        <Content Include="ConsumerProgram.txt" CopyToOutputDirectory="PreserveNewest" />
        <Content Include="NativeAotConsumer.txt" CopyToOutputDirectory="PreserveNewest" />
        <ProjectReference Include="..\..\src\Soenneker.Contexor.Builder\Soenneker.Contexor.Builder.csproj" />
    </ItemGroup>

</Project>
